{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "correlation",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_correlation.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/correlation",
      "instrumentation": [
        {
          "module": "venus_observability.correlation",
          "functions": [
            "set_correlation_id",
            "get_correlation_id",
            "inject_correlation_id_into_headers",
            "extract_correlation_id_from_headers"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "Dockerfile",
    "fuzz",
    "pyproject.toml",
    "src",
    "uv.lock"
  ]
}
